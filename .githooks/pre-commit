#!/usr/bin/env bash
# Scout pre-commit hook — enforces the SPEC §6 modification envelope.
#
# Activate per-clone:
#   git config core.hooksPath .githooks
#
# Skip (explicit operator override, e.g. structural refactor day):
#   SCOUT_SKIP_ENVELOPE=1 git commit ...
#
# Exit 0 = commit allowed; 2 = out-of-envelope; 3 = unknown path.

set -euo pipefail

if [[ "${SCOUT_SKIP_ENVELOPE:-0}" == "1" ]]; then
  echo "pre-commit: SCOUT_SKIP_ENVELOPE=1 — bypassing envelope check" >&2
  exit 0
fi

REPO="$(git rev-parse --show-toplevel)"
if [[ ! -x "$REPO/scripts/envelope-check.sh" ]]; then
  echo "pre-commit: scripts/envelope-check.sh missing or not executable" >&2
  exit 0   # do not block on a broken hook — envelope validator is a safety net, not a gate
fi

bash "$REPO/scripts/envelope-check.sh"
