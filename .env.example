# Scout LLM configuration — copy to .env and fill in.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...replace-me...
LLM_MODEL=google/gemini-2.5-flash-lite

# Optional:
# GITHUB_TOKEN=ghp_...              # raises the GitHub API rate limit
# SCOUT_SWARM_SIZE=1                # 1 = single agent (default), >1 = specialist swarm
# SCOUT_PARALLEL_REPOS=1            # parallel repo evals in batch mode
# SCOUT_DRY_RUN=1                   # skip build/test/coverage (stubs; no mvn/gradle needed)
# SCOUT_ESCALATION_BUDGET=3
# SCOUT_MAX_TOOL_CALLS=60

# --- Docker-backed builds (alternative to host mvn/gradle) ---------------
# When SCOUT_USE_DOCKER=1, run_build / run_tests / run_coverage dispatch
# the mvn/gradle invocation to the scout-builder container instead of
# running on the host. Build the image once: `bash scripts/build-docker-image.sh`.
#
# SCOUT_USE_DOCKER=1
# SCOUT_BUILD_IMAGE=scout-builder:latest
# SCOUT_DOCKER_CACHE_DIR=~/.scout-docker-cache   # persisted ~/.m2 and ~/.gradle
# SCOUT_DOCKER_MEM=4g
# SCOUT_DOCKER_CPUS=2
# SCOUT_DOCKER_NETWORK=bridge                    # or "none" for offline
# SCOUT_DOCKER_EXTRA_ARGS=                       # extras spliced into `docker run`
